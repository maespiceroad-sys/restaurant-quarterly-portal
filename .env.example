MAX_REPORTS_PER_COMPANY=4
PORT=4180
PUBLIC_SITE_URL=http://localhost:4180

# Leave DOWNLOAD_PDFS=true so the site can open local PDF files.
DOWNLOAD_PDFS=true

# SMTP settings for update notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@example.com
SMTP_PASS=your-app-password
MAIL_FROM=your-account@example.com
MAIL_TO=your-address@example.com

# true: send summary every run
# false: send only when new PDFs are found
REPORT_NOTIFY_ALWAYS=false
